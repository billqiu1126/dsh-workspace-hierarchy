{
  "name": "@billqiu1126/dsh-workspace-hierarchy",
  "description": "DeepSeek Harness web plugin: hierarchical workspace browser. Nests workspaces by directory path (main/sub-workspace) and adds an \"Add sub-workspace\" action to each workspace's + menu.",
  "version": "0.1.1",
  "author": "Bill Qiu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billqiu1126/dsh-workspace-hierarchy.git"
  },
  "homepage": "https://github.com/billqiu1126/dsh-workspace-hierarchy#readme",
  "bugs": {
    "url": "https://github.com/billqiu1126/dsh-workspace-hierarchy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "tools/move-session.js",
    "README.md",
    "README.zh.md",
    "install.ps1",
    "install.sh"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "workspace"
  ]
}
